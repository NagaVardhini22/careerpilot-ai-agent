# =============================================================================
# CAREERPILOT - Environment Configuration Template
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=careerpilot_db

# AI / LLM Configuration
# Set LLM_PROVIDER to "openai", "gemini", or "mock" (default for offline development)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional OpenAI Compatible Endpoint (e.g. Groq, Ollama, OpenRouter)
# OPENAI_BASE_URL=https://api.openai.com/v1

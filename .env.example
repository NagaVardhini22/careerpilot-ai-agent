# CareerPilot — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# Server Port & Mode
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
# You can provide either standard individual parameters OR a connection URL (e.g. Railway MYSQL_URL / DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=careerpilot_db
# DATABASE_URL=mysql://user:pass@host:port/dbname
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Authentication & Session Security
# REQUIRED in production: Must be an explicit, strong secret of at least 32 characters.
# In development, a default fallback secret is provided if left blank.
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long

# Emergency / Administrative API Key (Optional)
ADMIN_API_KEY=

# AI LLM Provider Configuration
# Options: 'mock' (zero-cost deterministic planner), 'openai', 'gemini'
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# External Job Providers (Optional)
# Greenhouse & Lever public boards work out-of-the-box with ZERO API keys.
# Configure the keys below only if you wish to enable additional aggregators:
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
SERPAPI_API_KEY=
